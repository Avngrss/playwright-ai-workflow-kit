{
  "name": "playwright-ai-automation-framework",
  "version": "1.0.0",
  "description": "AI-assisted Playwright and TypeScript automation framework for API, UI, E2E, visual, TMS-assisted, cross-browser, and responsive testing workflows.",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test --pass-with-no-tests",
    "test:list": "npx playwright test --list --pass-with-no-tests",
    "test:api": "npx playwright test --project=api --pass-with-no-tests",
    "test:ui": "npx playwright test --project=ui-chromium --pass-with-no-tests",
    "test:e2e": "npx playwright test --project=e2e --pass-with-no-tests",
    "test:smoke": "npx playwright test --grep @smoke --pass-with-no-tests",
    "test:regression": "npx playwright test --grep @regression --pass-with-no-tests",
    "test:visual": "npx playwright test --grep @visual --pass-with-no-tests",
    "test:cross-browser": "npx playwright test --grep @cross-browser --pass-with-no-tests",
    "test:responsive": "npx playwright test --grep @responsive --pass-with-no-tests",
    "project-map:update": "node scripts/project-cartographer.mjs",
    "conventions:check": "node scripts/check-conventions.mjs",
    "qa:gate": "npm run conventions:check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/mcp": "^0.0.75",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.6.0",
    "allure-playwright": "^3.9.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  }
}
