{
  "name": "playwright-ai-workflow-kit",
  "version": "1.0.0",
  "description": "AI-assisted workflow kit for planning, implementing, reviewing, auditing, and maintaining Playwright automation projects.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avngrss/playwright-ai-workflow-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Avngrss/playwright-ai-workflow-kit/issues"
  },
  "homepage": "https://github.com/Avngrss/playwright-ai-workflow-kit#readme",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test --project=api --project=ui-chromium --project=e2e --pass-with-no-tests",
    "test:list": "npx playwright test --list --pass-with-no-tests",
    "test:api": "npx playwright test --project=api --pass-with-no-tests",
    "test:ui": "npx playwright test --project=ui-chromium --pass-with-no-tests",
    "test:e2e": "npx playwright test --project=e2e --pass-with-no-tests",
    "test:smoke": "npx playwright test --project=api --project=ui-chromium --project=e2e --grep @smoke --pass-with-no-tests",
    "test:regression": "npx playwright test --project=api --project=ui-chromium --project=e2e --grep @regression --pass-with-no-tests",
    "test:visual": "npx playwright test --project=ui-chromium --grep @visual --pass-with-no-tests",
    "test:cross-browser": "npx playwright test --project=ui-chromium --project=ui-firefox --project=ui-webkit --grep @cross-browser --pass-with-no-tests",
    "test:responsive": "npx playwright test --project=ui-mobile-chromium --grep @responsive --pass-with-no-tests",
    "report:allure:generate": "allure generate allure-results --clean -o allure-report",
    "project-map:update": "node scripts/project-cartographer.mjs",
    "conventions:check": "node scripts/check-conventions.mjs",
    "qa:gate": "npm run conventions:check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/mcp": "^0.0.75",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.6.0",
    "allure": "^3.14.0",
    "allure-js-commons": "^3.9.0",
    "allure-playwright": "^3.9.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  }
}
