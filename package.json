{
  "name": "playwright-ai-workflow-kit",
  "version": "1.0.0",
  "description": "A Playwright + TypeScript test home for Cursor: plan, implement and verify API, UI and E2E tests with AI agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avngrss/playwright-ai-workflow-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Avngrss/playwright-ai-workflow-kit/issues"
  },
  "homepage": "https://github.com/Avngrss/playwright-ai-workflow-kit#readme",
  "private": true,
  "scripts": {
    "test:visual": "node scripts/run-tests.mjs visual",
    "test:cross-browser": "node scripts/run-tests.mjs cross-browser",
    "test:responsive": "node scripts/run-tests.mjs responsive",
    "browsers:install:all": "npx playwright install",
    "postinstall": "node scripts/run-tests.mjs --browsers",
    "test": "node scripts/run-tests.mjs all",
    "test:list": "npx playwright test --list --reporter=list --pass-with-no-tests",
    "test:api": "node scripts/run-tests.mjs api",
    "test:ui": "node scripts/run-tests.mjs ui",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "test:smoke": "node scripts/run-tests.mjs smoke",
    "test:app": "node scripts/run-tests.mjs app",
    "test:regression": "node scripts/run-tests.mjs regression",
    "data:sweep": "npx playwright test --grep @data-sweep-only --pass-with-no-tests --reporter=null",
    "auth:check": "node scripts/auth.mjs check",
    "auth:sign-in": "node scripts/auth.mjs sign-in",
    "suite:coverage": "node scripts/agent/suite-coverage.mjs",
    "env:prepare": "node scripts/agent/prepare-env.mjs",
    "app:add": "node scripts/agent/add-app.mjs",
    "test:flaky": "node scripts/run-tests.mjs flaky",
    "browsers:install": "npx playwright install chromium",
    "typecheck": "tsc --noEmit",
    "qa:gate": "node scripts/gate/check.mjs && npm run typecheck",
    "allure:report": "allure generate reports/allure/results --output reports/allure/html",
    "allure:open": "allure open reports/allure/results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/mcp": "^0.0.75",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.3",
    "allure": "^3.19.0",
    "allure-playwright": "^3.13.0",
    "dotenv": "^18.0.4",
    "typescript": "^7.0.2"
  }
}
