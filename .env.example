# Starter environment template — provider-agnostic placeholders only.
# Copy to .env locally and fill values for your target application.
# Never commit .env or real secrets to the repository.
#
# Env names may be adapted per project, but update the project map and docs if changed.

# --- Application under test (simple single-app projects) ---

# UI application base URL for ui-chromium and e2e Playwright projects
UI_BASE_URL=

# API base URL for API Playwright project and API tests
API_BASE_URL=

# --- Optional UI preconditions (simple projects) ---

# Optional API backend for UI/E2E backend preconditions only.
# Use when UI or E2E tests need approved backend setup before the UI action under test.
# Must point to the same API backend used by the UI runtime when preconditions are implemented.
UI_PRECONDITION_API_BASE_URL=

# --- Multi-target examples (commented — use only when registered in project map) ---
#
# Real projects with multiple UI apps or API/microservices must define env names in
# .cursor/rules/00-project-map.mdc before use. Examples below are illustrative only.
#
# CUSTOMER_UI_BASE_URL=
# ADMIN_UI_BASE_URL=
# CHECKOUT_UI_BASE_URL=
#
# AUTH_API_BASE_URL=
# CATALOG_API_BASE_URL=
# ORDER_API_BASE_URL=
# PAYMENT_API_BASE_URL=

# --- Optional reporting ---

# Uncomment if you override the default Allure results directory locally.
# ALLURE_RESULTS_DIR=allure-results

# --- Optional TMS (comments only — no active provider tokens in repo) ---

# TMS tokens belong in user/global tool settings or local secret storage.
# Do not commit real TMS tokens to repository files.
# Qase is one supported example via user/global Cursor MCP when configured.
# Other TMS providers may be supported later through approved integration paths.
