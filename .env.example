# Copy to .env and fill in the values there — .env stays on your machine, never committed.
# The names come from specs/project-map.md; tests never read them directly (config and fixtures do).

# ─── Run settings ────────────────────────────────────────────────
# A DNS server slow to answer IPv6 lookups for an IPv4-only stand makes every first request time
# out (Playwright waits for both). "true" skips IPv6 lookups (IPv4 only).
AQA_SKIP_IPV6_LOOKUP=false

# ─── todomvc ─────────────────────────────────────────────────────
# Addresses and settings
UI_BASE_URL=https://demo.playwright.dev/todomvc
