
# Playwright
node_modules/
test-results/
playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
.auth/
state/
*.storage-state.json
.playwright-mcp/
.env
.env.uat
# Allure generated output (the config is allurerc.mjs at the root, tracked)
reports/allure/results/
reports/allure/html/
allure-results/
allure-report/
.scannerwork/
.sonarlint/
sonar-project.properties
.vscode/

# Temporary agent discovery/debug artifacts
discover-*-output.json
scripts/debug-*.mjs
scripts/discover-*.mjs
scripts/scratch-*.mjs

reports/allure/history.jsonl
.playwright-cli/
# Readable run summary (written by every run)
reports/run-summary.md
reports/run-summary.json
# Each test's last result, merged by every run (scripts/agent/suite-coverage.mjs reads it)
reports/last-results.json
# Lines a verify cut off left spoiled (npm run verify -- --restore puts them back)
reports/verify-spoils.json
# The last verify's result and its automatic-heal attempt (an agent's stop hook reads it)
reports/verify-state.json
